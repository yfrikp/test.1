# ============================================================
#  题目1 独立工作区 · 忽略规则
# ============================================================

# ROS2 / colcon 编译产物（每台机器重新编译即可，不进仓库）
build/
install/
log/

# Python
__pycache__/
*.pyc
*.pyo

# VS Code 的机器相关文件（环境变量快照，每台机器不一样）
.vscode/ros.env

# 合成图集：324 张带噪 PNG 共约 132MB，用一条命令随时重新生成
#   python3 py/make_test_images.py --out samples_synth
# 真值表 ground_truth.csv 会一起生成；评测结果已存档在 results/
samples_synth/

# 临时/调试文件
_debug_*.png

# ============================================================
#  YOLO 分支（加分项②）
# ============================================================
# 训练用的数据集是 samples_synth 的 324 张图复制出来的（约 132MB）
# 用 python3 yolo/train_yolo.py 一条命令就能重建
yolo/dataset/
yolo/train.log
yolo/runs/*/weights/last.pt
weights/
